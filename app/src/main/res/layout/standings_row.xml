<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#efefef">
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        >

        <TextView
            android:id="@+id/txtTmPos"
            android:textColor="#222"
            android:layout_width="28dp"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            android:text="1" />

        <TextView
            android:id="@+id/txtTmName"
            android:textColor="#222"
            android:layout_width="152dp"
            android:layout_height="wrap_content"
            android:text="Arsenal"
            android:textAlignment="center" />

        <TextView
            android:id="@+id/txtTmPts"
            android:textColor="#222"
            android:layout_width="29dp"
            android:textAlignment="center"
            android:layout_height="wrap_content"
            android:text="56" />

        <TextView
            android:id="@+id/txtTmPlayed"
            android:layout_width="29dp"
            android:layout_height="wrap_content"
            android:text="15"
            android:textAlignment="center"
            android:textColor="#222" />

        <TextView
            android:id="@+id/txtTmWins"
            android:layout_width="29dp"
            android:layout_height="wrap_content"
            android:text="11"
            android:textAlignment="center"
            android:textColor="#222" />

        <TextView
            android:id="@+id/txtTmDraws"
            android:layout_width="29dp"
            android:layout_height="wrap_content"
            android:text="3"
            android:textAlignment="center"
            android:textColor="#222" />

        <TextView
            android:id="@+id/txtTmLoss"
            android:textColor="#222"
            android:layout_width="29dp"
            android:textAlignment="center"
            android:layout_height="wrap_content"
            android:text="2" />

        <TextView
            android:id="@+id/txtTmGF"
            android:textColor="#222"
            android:layout_width="29dp"
            android:layout_height="wrap_content"
            android:text="69"
            android:textAlignment="center" />

        <TextView
            android:id="@+id/txtTmGA"
            android:textColor="#222"
            android:layout_width="29dp"
            android:layout_height="wrap_content"
            android:text="25"
            android:textAlignment="center" />


    </LinearLayout>

</LinearLayout>