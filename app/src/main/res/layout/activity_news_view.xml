<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbarAlwaysDrawHorizontalTrack="false"
    android:scrollbarAlwaysDrawVerticalTrack="true"
    android:scrollbarFadeDuration="2000"
    android:scrollbars="vertical"
    android:isScrollContainer="true"
    tools:context="com.goldengear.tikvah.NewsView">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:id="@+id/lnlNV">
        <TextView
            android:id="@+id/nvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/strNewsTitle"
            android:textColor="#000"
            android:textSize="24sp"/>

            <ImageView
                android:id="@+id/nvImg"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                app:srcCompat="@drawable/sucks"
                android:scaleType="centerInside"
                app:layout_constraintTop_toBottomOf="@id/nvTitle"
                tools:layout_editor_absoluteX="0dp"

                />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="19sp"
            android:text="@string/blabla"
            app:layout_constraintTop_toBottomOf="@id/nvImg"
            android:isScrollContainer="true"
            android:scrollbars="vertical"
            android:id="@+id/nvCont"/>
        </LinearLayout>
    </ScrollView>

    <com.google.android.gms.ads.AdView xmlns:ads="http://schemas.android.com/apk/res-auto"
        android:id="@+id/adView2"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginEnd="8dp"
        android:layout_marginRight="8dp"
        ads:adSize="BANNER"
        ads:adUnitId="ca-app-pub-8089746021276960/9388829388"
        ads:layout_constraintBottom_toBottomOf="parent"
        ads:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>