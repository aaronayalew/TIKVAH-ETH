<?xml version="1.0" encoding="utf-8"?>
<android.support.v7.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:background="#c0c0c0"
    android:layout_marginBottom="11dp"
    app:cardElevation="8dp"
    app:cardCornerRadius="5dp"

    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="0dp"
        android:layout_marginRight="0dp"
        android:layout_marginLeft="0dp"

        android:background="#ffffff">

        <TextView
            android:id="@+id/artTimeNoImg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginBottom="0dp"
            android:layout_marginRight="8dp"
            android:layout_marginTop="10dp"
            android:text="December 22, 2018"
            android:textAlignment="textEnd"
            android:textColor="#aaa"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/artTitleNoImg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Lorem IpsumLorem Ipsum Lorem Ipsum Lorem Ipsum Lorem Ipsum"
            android:textSize="22sp"
            android:textAlignment="center"
            android:textColor="#000"
            />

        <TextView
            android:id="@+id/artDescNoImg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="8dp"
            android:text="This will be a short description of the news mannnnnthis will be so dope everyone will dig it this will be so lit like so fucking lit This will be a short description of the news mannnnnthis will be so dope everyone will dig it this will be so lit like so fucking lit This will be a short description of the news mannnnnthis will be so dope everyone will dig it this will be so lit like so fucking lit"
            android:textSize="18sp"
            android:textColor="#000"
            android:maxLines="6"
            android:ellipsize="marquee"/>

        <ImageButton
            android:id="@+id/btnExpandNoImg"
            android:padding="0dp"
            android:layout_gravity="right"
            android:layout_marginRight="15dp"
            android:layout_marginBottom="8dp"
            android:layout_marginTop="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/expand" />


    </LinearLayout>

</android.support.v7.widget.CardView>