<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="0dp"
    android:background="#dddddd"

    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="11dp"
        android:orientation="vertical"
        android:padding="0dp"
        android:layout_marginRight="0dp"
        android:layout_marginLeft="0dp"

        android:background="#ffffff">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="textEnd"
            android:layout_gravity="end"
            android:text="December 22, 2018"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="15dp"
            android:textSize="20sp"
            android:textColor="#aaa"
            android:layout_marginRight="8dp"
            android:id = "@+id/artTimeNoImg"/>

        <TextView
            android:id="@+id/artTitleNoImg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Lorem IpsumLorem Ipsum Lorem Ipsum Lorem Ipsum Lorem Ipsum"
            android:textSize="22sp"
            android:textAlignment="center"
            android:textColor="#000"
            />

        <TextView
            android:id="@+id/artDescNoImg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="8dp"
            android:text="This will be a short description of the news mannnnnthis will be so dope everyone will dig it this will be so lit like so fucking lit This will be a short description of the news mannnnnthis will be so dope everyone will dig it this will be so lit like so fucking lit This will be a short description of the news mannnnnthis will be so dope everyone will dig it this will be so lit like so fucking lit"
            android:textSize="18sp"
            android:textColor="#000"
            android:maxLines="6"
            android:ellipsize="marquee"/>

        <android.support.design.widget.FloatingActionButton
            android:id="@+id/btnExpandNoImg"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_gravity="end"
            android:layout_marginBottom="15dp"
            android:layout_marginRight="20dp"
            app:srcCompat="@drawable/ic_expand"
            android:clickable="true"
            android:focusable="true"
            android:scaleType="centerCrop"
            app:backgroundTint="@color/colorPrimary" />

    </LinearLayout>

</FrameLayout>